  "payroll": {
    "structure": "Enout Standard Structure",
    "from_date": "2026-04-01",
    "earnings": [
      {
        "component": "Basic",
        "abbr": "B",
        "formula": "base * 0.5"
      },
      {
        "component": "House Rent Allowance",
        "abbr": "HRA",
        "formula": "base * 0.2"
      },
      {
        "component": "Special Allowance",
        "abbr": "SA",
        "formula": "base * 0.3"
      }
    ],
    "deductions": [
      {
        "component": "Provident Fund",
        "abbr": "PF",
        "formula": "B * 0.12 if B <= 15000 else 1800",
        "fixed": true
      },
      {
        "component": "Professional Tax",
        "abbr": "PT",
        "amount": 200,
        "fixed": true
      }
    ],
    "_note": "base = monthly CTC from the employees CSV (monthly_ctc column). Components marked fixed do not depend on payment days (PF is derived from Basic, which is already prorated). PT 200/month shown; set your state's slab."
  },
  "payroll_settings": {
    "payroll_based_on": "Attendance",
    "consider_unmarked_attendance_as": "Present",
    "include_holidays_in_total_working_days": 0,
